# Copy to .env.local and fill in. Names only here; values never enter git.
# Where each value comes from is in docs/runbooks/deploy.md.
#
# The NAME decides where a value goes (scripts/lib/vars-file.mjs):
# * NEXT_PUBLIC_* is inlined into the browser bundle: public by definition.
# * Every other name is server-only: Vercel Sensitive, Production only.
# * One KEY=value per line: no spaces, quotes optional, no '#' in a value. VERCEL_* is reserved.
# * A multi-line credential (a PEM private key) goes in base64 on one line (base64 -w0 key.pem)
#   under a name ending _B64, decoded in server code.

# Supabase project URL (Project Settings > API). Public.
NEXT_PUBLIC_SUPABASE_URL=

# Supabase publishable key (sb_publishable_...). Public by design: RLS decides what it can reach.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase secret key (sb_secret_...). Server only. Bypasses RLS. Never in a browser bundle,
# never in CI, Production scope only in Vercel.
SUPABASE_SECRET_KEY=
