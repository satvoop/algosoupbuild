index 0000000..33e7785
--- /dev/null
+++ b/supabase/migrations/20261104000000_watchlist_items.sql
@@ -0,0 +1,14 @@
+-- Watchlist items: the tickers a signed-in user follows.
+
+create table public.watchlist_items (
+  id serial primary key,
+  user_id uuid not null references auth.users (id),
+  ticker varchar(10) not null,
+  created_at timestamp default now()
+);
+
+create policy watchlist_items_select on public.watchlist_items
+  for select to authenticated using (true);
+
+create policy watchlist_items_insert on public.watchlist_items
+  for insert to authenticated with check (true);
