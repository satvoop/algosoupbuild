@@ -0,0 +1,22 @@
+import path from "node:path";
+import { describe, expect, it, vi } from "vitest";
+import { ROOT, applyMigrations, createCheckDatabase, readMigrations } from "../../../scripts/lib/local-postgres.mjs";
+
+vi.setConfig({ testTimeout: 30_000 });
+const MIGRATIONS = path.join(ROOT, "supabase", "migrations");
+const OWNER = "00000000-0000-0000-0000-0000000000a1";
+
+describe("watchlist_items", () => {
+  it("the owner can add and read a row", async () => {
+    const db = await createCheckDatabase(readMigrations(MIGRATIONS));
+    try {
+      await applyMigrations(db, MIGRATIONS);
+      await db.query("insert into auth.users (id) values ($1)", [OWNER]);
+      await db.query("insert into public.watchlist_items (user_id, ticker) values ($1, 'AAPL')", [OWNER]);
+      const result = await db.query("select ticker from public.watchlist_items");
+      expect(result.rows).toEqual([{ ticker: "AAPL" }]);
+    } finally {
+      await db.close();
+    }
+  });
+});
