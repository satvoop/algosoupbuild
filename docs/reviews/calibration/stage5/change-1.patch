+import { beforeEach, describe, expect, it, vi } from "vitest";
+
+type InsertResult = { error: { code: string } | null };
+const state: { user: { id: string } | null; insert: InsertResult; inserted: unknown[] } = {
+  user: null,
+  insert: { error: null },
+  inserted: [],
+};
+
+vi.mock("@/lib/supabase/server", () => ({
+  createSupabaseServerClient: async () => ({
+    auth: { getUser: async () => ({ data: { user: state.user } }) },
+    from: () => ({
+      insert: async (row: unknown) => {
+        state.inserted.push(row);
+        return state.insert;
+      },
+    }),
+  }),
+}));
+
+const { POST } = await import("./route");
+const { parseTicker } = await import("./parse-ticker");
+
+function post(body: string): Request {
+  return new Request("http://localhost/api/watchlist", { method: "POST", body, headers: { "content-type": "application/json" } });
+}
+
+beforeEach(() => {
+  state.user = { id: "user-1" };
+  state.insert = { error: null };
+  state.inserted = [];
+  vi.spyOn(console, "error").mockImplementation(() => undefined);
+});
+
+describe("POST /api/watchlist", () => {
+  it("201: adds a trimmed, upper-cased ticker for the signed-in user", async () => {
+    const response = await POST(post(JSON.stringify({ ticker: " aapl " })));
+    expect(response.status).toBe(201);
+    expect(await response.json()).toEqual({ ticker: "AAPL" });
+    expect(state.inserted).toEqual([{ user_id: "user-1", ticker: "AAPL" }]);
+  });
+
+  it("401: signed out, nothing is inserted", async () => {
+    state.user = null;
+    const response = await POST(post(JSON.stringify({ ticker: "AAPL" })));
+    expect(response.status).toBe(401);
+    expect(await response.json()).toEqual({ error: "unauthenticated" });
+    expect(state.inserted).toEqual([]);
+  });
+
+  it("400: a malformed body or an invalid ticker, nothing is inserted", async () => {
+    for (const body of ["{not json", JSON.stringify({ ticker: "TOOLONG" }), JSON.stringify({ ticker: 42 }), JSON.stringify({})]) {
+      const response = await POST(post(body));
+      expect(response.status).toBe(400);
+      expect(await response.json()).toEqual({ error: "invalid_ticker" });
+    }
+    expect(state.inserted).toEqual([]);
+  });
+
+  it("409: the ticker is already on the list (unique violation 23505)", async () => {
+    state.insert = { error: { code: "23505" } };
+    const response = await POST(post(JSON.stringify({ ticker: "AAPL" })));
+    expect(response.status).toBe(409);
+    expect(await response.json()).toEqual({ error: "duplicate" });
+  });
+
+  it("500: any other insert error is reported, not swallowed", async () => {
+    state.insert = { error: { code: "42501" } };
+    const response = await POST(post(JSON.stringify({ ticker: "AAPL" })));
+    expect(response.status).toBe(500);
+    expect(await response.json()).toEqual({ error: "insert_failed" });
+  });
+});
+
+describe("parseTicker", () => {
+  it("accepts 1-5 letters after trimming and upper-casing, and rejects anything else", () => {
+    expect(parseTicker({ ticker: "msft" })).toBe("MSFT");
+    expect(parseTicker({ ticker: "" })).toBeNull();
+    expect(parseTicker({ ticker: "BRK.B" })).toBeNull();
+    expect(parseTicker(null)).toBeNull();
+  });
+});
