+const TICKER = /^[A-Z]{1,5}$/;
+
+/** The ticker from a request body, trimmed and upper-cased, or null when it is not one. */
+export function parseTicker(body: unknown): string | null {
+  if (typeof body !== "object" || body === null || !("ticker" in body)) return null;
+  const raw: unknown = body.ticker;
+  if (typeof raw !== "string") return null;
+  const ticker = raw.trim().toUpperCase();
+  return TICKER.test(ticker) ? ticker : null;
+}
